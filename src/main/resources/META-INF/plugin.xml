<idea-plugin>
    <id>com.vibrant.prismio</id>
    <name>Prismio Language Support</name>
    <vendor url="https://github.com/Vibrant275">Vibrant</vendor>

    <description><![CDATA[
        <h2>Prismio Language Support</h2>
        <p>
            Complete language support for Prismio - a modern, performance-focused programming language.
        </p>

        <h3>Features:</h3>
        <ul>
            <li><b>Advanced Syntax Highlighting</b> - Rich, context-aware color schemes for all language constructs</li>
            <li><b>Smart Code Completion</b> - Intelligent suggestions for keywords, types, and common patterns</li>
            <li><b>Code Formatting</b> - Automatic code formatting with customizable style settings</li>
            <li><b>Semantic Analysis</b> - Real-time detection of common issues and best practices</li>
            <li><b>Live Templates</b> - Quick code generation for common patterns</li>
            <li><b>Brace Matching</b> - Automatic completion of parentheses, brackets, and braces</li>
            <li><b>Comment Support</b> - Line and block comment toggling</li>
            <li><b>Structure View</b> - Navigate your code with the structure panel</li>
            <li><b>File Templates</b> - Create new files with predefined templates</li>
        </ul>

        <h3>Supported Features:</h3>
        <ul>
            <li>Functions and parameters</li>
            <li>Structs and enums</li>
            <li>Traits and implementations</li>
            <li>Control flow (if/else, while, for, loop, match)</li>
            <li>Variable declarations (let, let mut)</li>
            <li>External function declarations</li>
            <li>Import statements</li>
            <li>Arrays and array indexing</li>
            <li>String operations</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <h3>Version 1.0.0 - Complete Release</h3>
        <ul>
            <li>✨ Complete syntax highlighting with semantic analysis</li>
            <li>✨ Smart code completion for keywords, types, and templates</li>
            <li>✨ Advanced code formatter with customizable settings</li>
            <li>✨ Live templates for common code patterns</li>
            <li>✨ Automatic brace, bracket, and quote matching</li>
            <li>✨ Comment toggling support (Ctrl+/)</li>
            <li>✨ Comprehensive color settings page</li>
            <li>✨ Enhanced file icons and visual indicators</li>
            <li>✨ Code structure navigation</li>
            <li>✨ File templates for quick project setup</li>
        </ul>

        <h3>Version 0.0.3</h3>
        <ul>
            <li>Basic syntax highlighting for .psm files</li>
        </ul>

        <h3>Version 0.0.2</h3>
        <ul>
            <li>Logo update and minor fixes</li>
        </ul>

        <h3>Version 0.0.1</h3>
        <ul>
            <li>Initial test release</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File Type -->
        <fileType
                name="Prismio File"
                implementationClass="com.vibrant.prismio.PsFileType"
                fieldName="INSTANCE"
                language="Prismio"
                extensions="psm"/>

        <!-- Parser and Lexer -->
        <lang.parserDefinition
                language="Prismio"
                implementationClass="com.vibrant.prismio.SimpleParserDefinition"/>

        <!-- Syntax Highlighting -->
        <lang.syntaxHighlighterFactory
                language="Prismio"
                implementationClass="com.vibrant.prismio.highlighter.PsSyntaxHighlighterFactory"/>

        <!-- Color Settings -->
        <colorSettingsPage
                implementation="com.vibrant.prismio.settings.PrismioColorSettingsPage"/>

        <!-- Annotator for Semantic Highlighting -->
        <annotator
                language="Prismio"
                implementationClass="com.vibrant.prismio.annotator.PrismioAnnotator"/>

        <!-- Code Completion -->
        <completion.contributor
                language="Prismio"
                implementationClass="com.vibrant.prismio.completion.PrismioCompletionContributor"/>

        <!-- Code Formatting -->
        <lang.formatter
                language="Prismio"
                implementationClass="com.vibrant.prismio.PrismioFormattingModelBuilder"/>

        <!-- Code Style Settings -->
        <codeStyleSettingsProvider
                implementation="com.vibrant.prismio.SimpleCodeStyleSettingsProvider"/>

        <langCodeStyleSettingsProvider
                implementation="com.vibrant.prismio.LanguageCodeStyleSettingsProvider"/>

        <!-- Comment Support -->
        <lang.commenter
                language="Prismio"
                implementationClass="com.vibrant.prismio.Commenter"/>

        <!-- Brace Matching -->
        <lang.braceMatcher
                language="Prismio"
                implementationClass="com.vibrant.prismio.PrismioBraceMatcher"/>

        <!-- Quote Handler -->
        <lang.quoteHandler
                language="Prismio"
                implementationClass="com.vibrant.prismio.PrismioQuoteHandler"/>

        <!-- Typed Handler for Auto-completion -->
        <typedHandler
                implementation="com.vibrant.prismio.handler.PrismioTypedHandler"/>

        <!-- Structure View -->
        <lang.psiStructureViewFactory
                language="Prismio"
                implementationClass="com.vibrant.prismio.SimpleStructureViewFactory"/>

        <!-- Navigation Bar -->
        <navbar
                implementation="com.vibrant.prismio.SimpleStructureAwareNavbar"/>

        <!-- Icon Provider -->
        <iconProvider
                implementation="com.vibrant.prismio.providers.PsPropertyIconProvider"/>

        <!-- File Templates -->
        <internalFileTemplate name="Prismio File"/>
        <fileTemplateGroup
                implementation="com.vibrant.prismio.template.PrismioTemplateGroupDescriptor"/>

        <!-- Find Usages -->
        <lang.findUsagesProvider
                language="Prismio"
                implementationClass="com.vibrant.prismio.SimpleFindUsagesProvider"/>

        <!-- Refactoring Support -->
        <lang.refactoringSupport
                language="Prismio"
                implementationClass="com.vibrant.prismio.SimpleRefactoringSupportProvider"/>

        <!-- Documentation Provider -->
        <lang.documentationProvider
                language="Prismio"
                implementationClass="com.vibrant.prismio.SimpleDocumentationProvider"/>

        <!-- Folding Builder -->
        <lang.foldingBuilder
                language="Prismio"
                implementationClass="com.vibrant.prismio.SimpleFoldingBuilder"/>

        <!-- Line Marker Provider -->
        <codeInsight.lineMarkerProvider
                language="Prismio"
                implementationClass="com.vibrant.prismio.SimpleLineMarkerProvider"/>

        <!-- Spellchecking -->
        <spellchecker.support
                language="Prismio"
                implementationClass="com.vibrant.prismio.SimpleSpellcheckingStrategy"/>

        <!-- Go to Symbol -->
        <gotoSymbolContributor
                implementation="com.vibrant.prismio.SimpleChooseByNameContributor"/>
    </extensions>

    <actions>
        <!-- New File Action -->
        <action
                id="com.vibrant.prismio.template.CreateClassAction"
                class="com.vibrant.prismio.template.CreateClassAction"
                text="Prismio File"
                description="Create new Prismio file"
                icon="/icons/prismio.png">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
    </actions>
</idea-plugin>